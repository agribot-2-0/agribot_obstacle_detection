<launch>

    <param name="/use_sim_time" value="true"/>

    <arg name="bag_name" default="livox_test_1"/>
    <arg name="bag_path" value="/home/olek/projects/agribot_ws/src/agribot_obstacle_detection/bags/$(arg bag_name).bag"/>

    <arg name="ros_vis" default="true"/>

    <!-- Obstacle detection node -->
    <include file="$(find agribot_obstacle_detection)/launch/lidar_detection.launch" >
        <arg name="ros_vis" value="$(arg ros_vis)"/>
    </include>

    <!-- Bag playback -->
    <include file="$(find agribot_bringup)/launch/bringup_playback.launch" >
        <arg name="vis" value="$(arg ros_vis)" />
        <arg name="bag_path" value="$(arg bag_path)" />
        <arg name="loop" value="false" />
    </include>

</launch>