<launch>
  <arg name="detection_namespace"                       default="agribot/obstacle_detection"/>

  <!-- Lidar arguments -->
  <arg name="lidar_namespace"                           default="front/3d/lidar"/>
  <arg name="lidar_point_cloud_topic"                   value="$(arg lidar_namespace)/point_cloud"/>
  <arg name="lidar_objects_topic"                       value="$(arg lidar_namespace)/objects"/>
  <arg name="lidar_objects_markers_topic"               value="$(arg lidar_namespace)/objects_markers"/>
  <arg name="lidar_processing_time_topic"               value="$(arg lidar_namespace)/processing_time"/>

  <!-- Stereo camera arguments -->
  <arg name="stereo_camera_namespace"                   default="front/3d/stereo_camera"/>
  <arg name="stereo_camera_point_cloud_topic"           value="$(arg stereo_camera_namespace)/point_cloud"/>
  <arg name="stereo_camera_objects_topic"               value="$(arg stereo_camera_namespace)/objects"/>
  <arg name="stereo_camera_objects_markers_topic"       value="$(arg stereo_camera_namespace)/objects_markers"/>
  <arg name="stereo_camera_processing_time_topic"       value="$(arg stereo_camera_namespace)/processing_time"/>

  <!-- Fused data arguments -->
  <arg name="3d_fused_namespace"                        default="front/3d/fused"/>
  <arg name="3d_fused_objects_topic"                    value="$(arg 3d_fused_namespace)/objects"/>
  <arg name="3d_fused_objects_markers_topic"            value="$(arg 3d_fused_namespace)/objects_markers"/>


  <!-- Lidar pipeline node -->
  <node ns="$(arg detection_namespace)" pkg="agribot_obstacle_detection" type="lidar_point_cloud_pipeline_node" name="lidar_point_cloud_pipeline_node" output="screen" launch-prefix="">
    <remap from="~input_point_cloud"                    to="$(arg lidar_point_cloud_topic)"/>
    <remap from="~ground_point_cloud"                   to="$(arg lidar_point_cloud_topic)/ground"/>
    <remap from="~objects_point_cloud"                  to="$(arg lidar_point_cloud_topic)/objects"/>
    <remap from="~objects"                              to="$(arg lidar_objects_topic)"/>
    <remap from="~processing_time"                      to="$(arg lidar_processing_time_topic)"/>
  </node>

  <!-- Stereo camera pipeline node -->
  <node ns="$(arg detection_namespace)" pkg="agribot_obstacle_detection" type="stereo_camera_point_cloud_pipeline_node" name="stereo_camera_point_cloud_pipeline_node" output="screen" launch-prefix="">
    <remap from="~input_point_cloud"                    to="$(arg stereo_camera_point_cloud_topic)"/>
    <remap from="~ground_point_cloud"                   to="$(arg stereo_camera_point_cloud_topic)/ground"/>
    <remap from="~objects_point_cloud"                  to="$(arg stereo_camera_point_cloud_topic)/objects"/>
    <remap from="~objects"                              to="$(arg stereo_camera_objects_topic)"/>
    <remap from="~processing_time"                      to="$(arg stereo_camera_processing_time_topic)"/>
  </node>


  <!-- rviz_markers_visualization -->
  <node ns="$(arg detection_namespace)" pkg="agribot_obstacle_detection" type="object3d_array_visualization_node" name="front_3d_lidar_objects_visualization_node" output="screen">
    <param name="color"                   value="2"/>
    <!-- <param name="marker_namespace"        value="front_3d_lidar_objects"/> -->
    <param name="marker_namespace"        value="front_lidar"/>
    <remap from="~object3d_array"         to="$(arg lidar_objects_topic)"/>
    <remap from="~vision_markers"         to="$(arg lidar_objects_markers_topic)"/>
  </node>

  <node ns="$(arg detection_namespace)" pkg="agribot_obstacle_detection" type="object3d_array_visualization_node" name="front_3d_stereo_camera_objects_visualization_node" output="screen">
    <param name="color"                   value="6"/>
    <!-- <param name="marker_namespace"        value="front_3d_lidar_objects"/> -->
    <param name="marker_namespace"        value="front_stereo_camera"/>
    <remap from="~object3d_array"         to="$(arg stereo_camera_objects_topic)"/>
    <remap from="~vision_markers"         to="$(arg stereo_camera_objects_markers_topic)"/>
  </node>

</launch>
