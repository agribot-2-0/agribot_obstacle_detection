<launch>

  <arg name="obstacle_detection_topic" default="/agribot/obstacle_detected" />
  <arg name="vision_detection_topic" default="/agribot/vision_detection" />
  <arg name="detection_path_topic" default="/move_base/AgribotPlannerROS/local_path" />

  <arg name="obstacle_arbiter_markers_topic" default="/agribot/obstacle_arbiter_markers" />
  <arg name="vision_markers_topic" default="/agribot/vision_markers" />


  <include file="$(find agribot_obstacle_detection)/launch/lidar_detection.launch">
    <arg name="pointcloud_topic" value="/bumper/front/lidar" />
    <arg name="vision_detection_topic" value="$(arg vision_detection_topic)" />
  </include>

  <include file="$(find agribot_obstacle_detection)/launch/obstacle_arbiter.launch">
    <arg name="obstacle_detection_topic" value="$(arg obstacle_detection_topic)" />
    <arg name="vision_detection_topic" value="$(arg vision_detection_topic)" />
    <arg name="detection_path_topic" value="$(arg detection_path_topic)" />
    <arg name="obstacle_arbiter_markers_topic" value="$(arg obstacle_arbiter_markers_topic)" />
  </include>

  <include file="$(find agribot_obstacle_detection)/launch/obstacle_visualization.launch">
    <arg name="vision_detection_topic" default="$(arg vision_detection_topic)" />
    <arg name="vision_markers_topic" default="$(arg vision_markers_topic)" />
  </include>

  <include file="$(find agribot_obstacle_detection)/launch/obstacle_visualization.launch">
    <arg name="vision_detection_topic" default="/agribot/vision_detection/zed" />
    <arg name="vision_markers_topic" default="/agribot/vision_markers/zed" />
  </include>

</launch>
