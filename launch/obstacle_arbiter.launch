<launch>

    <arg name="robot_length"    default="1.4"/>
    <arg name="robot_width"     default="0.7"/>
    <arg name="width_offset"    default="0.3"/>

    <!-- Obstacle detection node -->
    <node pkg="agribot_obstacle_detection" type="obstacle_arbiter_node" name="obstacle_arbiter_node" output="screen" launch-prefix="">
        <param name="robot_length"  value="$(arg robot_length)"/>
        <param name="robot_width"   value="$(arg robot_width)"/>
        <param name="width_offset"  value="$(arg width_offset)"/>
    </node>
</launch>
