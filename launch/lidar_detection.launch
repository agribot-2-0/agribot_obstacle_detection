<launch>
  <arg name="pointcloud_topic"                default="/bumper/front/lidar"/>
  <arg name="vision_detection_topic"          default="/agribot/vision_detection"/>
  <arg name="lidar_processing_time_topic"     default="/bumper/front/lidar/processing_time_ms"/>
  
  <!-- Obstacle detection node -->
  <node pkg="agribot_obstacle_detection" type="lidar_obstacle_detection_node" name="lidar_obstacle_detection_node" output="screen" launch-prefix="">
    
    <remap from="~input_cloud"                to="$(arg pointcloud_topic)"/>
    <remap from="~ground_cloud"               to="$(arg pointcloud_topic)/ground"/>
    <remap from="~obstacles_cloud"            to="$(arg pointcloud_topic)/obstacles"/>
    <remap from="~vision_detection"           to="$(arg vision_detection_topic)"/>
    <remap from="~lidar_processing_time_ms"   to="$(arg lidar_processing_time_topic)"/>

  </node>

  <arg name="zed_pointcloud_topic"              default="/zed2/zed_node/point_cloud/cloud_registered"/>
  <arg name="zed_vision_detection_topic"        default="/agribot/vision_detection/zed"/>
  <arg name="zed_processing_time_topic"         default="/vision_detection/zed/processing_time_ms"/>
  
  <!-- Obstacle detection node -->
  <node pkg="agribot_obstacle_detection" type="lidar_obstacle_detection_node" name="zed_obstacle_detection_node" output="screen" launch-prefix="">
    
    <remap from="~input_cloud"                to="$(arg zed_pointcloud_topic)"/>
    <remap from="~ground_cloud"               to="$(arg zed_pointcloud_topic)/ground"/>
    <remap from="~obstacles_cloud"            to="$(arg zed_pointcloud_topic)/obstacles"/>
    <remap from="~vision_detection"           to="$(arg zed_vision_detection_topic)"/>
    <remap from="~lidar_processing_time_ms"   to="$(arg zed_processing_time_topic)"/>

  </node>
</launch>