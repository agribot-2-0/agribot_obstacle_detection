<launch>
  <arg name="PI" value="3.1415926535897931"/>

	<!-- Launch Lidar and ZED2 camera -->
	<include file="$(find hal_lidar)/launch/hal_lidar.launch" />
	<include file="$(find hal_zed2)/launch/zed2.launch" />
	<!-- Launch obstacle detection -->
	<include file="$(find agribot_obstacle_detection)/launch/agribot_obstacle_detection.launch" />
	<!-- Static tf publishers -->
	<node pkg="tf" type="static_transform_publisher" name="ground_lidar_broadcaster" args="0 0 0.748 0 0.122173048 0 base_footprint bumper_front_lidar_link 100" />
	<!-- <node pkg="tf" type="static_transform_publisher" name="lidar_zed_broadcaster" args="-0.05 0 0.0591 0 0 0 bumper_front_lidar_link zed2_camera_base_link 100" /> -->
	<node pkg="tf" type="static_transform_publisher" name="ground_zed_broadcaster" args="-0.05 0 0.8071 0 0.122173048 0 base_footprint zed2_camera_base_link 100" />
</launch>
