<launch>

  <!-- Main detection -->
  <!-- <include file="$(find agribot_obstacle_detection)/launch/agribot_obstacle_detection.launch"/> -->

  <!-- Main launch -->
  <arg name="vis" default="true"/>
  <arg name="perception_sensors" default="true"/>
  <arg name="perception_plugins" default="false"/>
  <arg name="launch_type" default="sim"/>
  <include file="$(find agribot_bringup)/launch/agribot_base.launch" >
    <arg name="vis" default="$(arg vis)"/>
    <arg name="perception_sensors" default="$(arg perception_sensors)"/>
    <arg name="perception_plugins" default="$(arg perception_plugins)"/>
    <arg name="launch_type" default="$(arg launch_type)"/>
  </include>

  <!-- Lidar -->
  <arg name="xfer_format" default="2"/>
  <include file="$(find hal_lidar)/launch/hal_lidar.launch" >
    <arg name="xfer_format" default="$(arg xfer_format)"/>
  </include>
  <!-- Socketcan (sonars) reader -->
  <node pkg="agribot_obstacle_detection" type="socketcan_sonar_reader_node.py" name="socketcan_sonar_reader_node"/>

  <!-- Detection observer app -->
  <node pkg="agribot_obstacle_detection" type="obstacle_detection_observer_app.py" name="obstacle_detection_observer_app"/>

  <!-- Depth clustering -->
  <!-- <arg name="num_beams" default="16"/>
  <include file="$(find depth_clustering)/launch/show_objects.launch" >
    <arg name="num_beams" default="$(arg num_beams)"/>
  </include> -->

  <!-- LOAM -->
  <arg name="loam_type" default="none"/>
  
  <!-- loam_livox -->
  <include file="$(find loam_livox)/launch/livox.launch" if="$(eval arg('loam_type') == 'loam_livox')"/>

  <!-- livox_mapping -->
  <include file="$(find livox_mapping)/launch/mapping_horizon.launch" if="$(eval arg('loam_type') == 'livox_mapping')"/>

  <!-- aloam -->
  <include file="$(find aloam_velodyne)/launch/aloam_velodyne_HDL_64.launch" if="$(eval arg('loam_type') == 'aloam')"/>

</launch>
