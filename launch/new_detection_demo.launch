<launch>

  <!-- Launch Lidar -->
  <include file="$(find hal_lidar)/launch/hal_lidar.launch" />

  <!-- Launch new obstacle detection -->
  <include file="$(find agribot_obstacle_detection)/launch/new_agribot_obstacle_detection.launch">
    <!-- TODO(olek) For now change lidar topic (for debugging purposes) -->
    <arg name="lidar_point_cloud_topic" value="/bumper/front/lidar" />
  </include>

  <!-- Static tf publisher -->
  <node pkg="tf" type="static_transform_publisher" name="ground_lidar_broadcaster" args="0 0 0.748 0 0.122173048 0 base_footprint bumper_front_lidar_link 100" />

</launch>
