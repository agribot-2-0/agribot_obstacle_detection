<launch>
  <arg name="load_description" default="false" />

  <!-- Launch new obstacle detection -->
  <include file="$(find agribot_obstacle_detection)/launch/agribot_obstacle_detection.launch" />

  <!-- Launch ZED2 -->
  <remap from="/zed2_node/point_cloud/cloud_registered" to="/agribot/obstacle_detection/front/3d/stereo_camera/point_cloud" />
  <include file="$(find hal_zed2)/launch/zed2.launch" />

  <!-- Launch Lidar -->
  <include file="$(find hal_lidar)/launch/hal_lidar.launch" />

  <!-- Load description with tf frames -->
  <include if="$(arg load_description)" file="$(find agribot_description)/launch/agribot_description.launch" />

  <node pkg="agribot_obstacle_detection" type="agri_transform_broadcaster.py" name="agri_transform_broadcaster" />

</launch>