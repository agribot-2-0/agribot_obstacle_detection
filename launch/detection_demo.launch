<launch>
  <!-- Launch new obstacle detection -->
  <include file="$(find agribot_obstacle_detection)/launch/agribot_obstacle_detection.launch" />

  <!-- Launch additional nodes (normally launched by agribot_bringup / hal_bringup -->
  <arg name="zed" default="false" />

  <!-- Launch zed2 if enabled -->
  <include if="$(arg zed)" file="$(find hal_zed2)/launch/zed2.launch">
    <remap from="/zed2/zed_node/point_cloud/cloud_registered" to="/agribot/obstacle_detection/front/3d/stereo_camera/point_cloud" />
  </include>

  <!-- Launch Lidar -->
  <include file="$(find hal_lidar)/launch/hal_lidar.launch" />

  <!-- Load description with tf frames -->
  <include file="$(find agribot_description)/launch/agribot_description.launch" />

</launch>
