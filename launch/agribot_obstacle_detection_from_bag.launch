<launch>

  <param name="/use_sim_time" value="true" />

  <arg name="bag_name" />
  <arg name="bag_path" value="$(find agribot_obstacle_detection)/bags/$(arg bag_name).bag" />
  
  <arg name="clock" default="false" />
  <arg name="rate" default="1.0" />

  <arg name="sonar_detection_config_file" default="sonar_detection.yaml" />

  <!-- Obstacle detection -->
  <include file="$(find agribot_obstacle_detection)/launch/agribot_obstacle_detection.launch" >
    <arg name="sonar_detection_config_file" value="$(arg sonar_detection_config_file)" />

  </include>

  <!-- Bag playback -->
  <include file="$(find agribot_bringup)/launch/bringup_playback.launch">
    <arg name="bag_path" value="$(arg bag_path)" />
    <arg name="clock" value="$(arg clock)" />
    <arg name="rate" value="$(arg rate)" />
  </include>

</launch>